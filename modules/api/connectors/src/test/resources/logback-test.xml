<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <!-- broker clients are very chatty at debug level -->
  <!-- the contract makes deliveries fail on purpose: their retry warnings are expected noise -->
  <logger name="xplat.connectors" level="OFF"/>
  <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
